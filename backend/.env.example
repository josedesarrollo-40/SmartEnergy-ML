# === Entorno ===
# development (por defecto) | test | production
# - development: permite SQLite local si no hay DATABASE_URL.
# - production: exige DATABASE_URL de PostgreSQL; SQLite queda prohibido.
APP_ENV=development

# === Base de datos ===
# Cadena de conexión a Neon PostgreSQL. Cópiala desde el panel de Neon
# (botón "Connect"). Usa el driver psycopg2 y SSL obligatorio.
#
# Formato:
#   DATABASE_URL=postgresql+psycopg2://USUARIO:CLAVE@HOST.neon.tech/DBNAME?sslmode=require
#
# Notas:
# - Neon suele dar la URL como "postgresql://...". Cámbiala a
#   "postgresql+psycopg2://..." para que SQLAlchemy use psycopg2.
# - Mantén "?sslmode=require" al final: Neon exige SSL.
# - En development/test, si no defines DATABASE_URL se usa SQLite local.
#   En production esto NO se permite: hay que definir DATABASE_URL.
DATABASE_URL=

# === Tarifa ===
DEFAULT_CURRENCY=COP
DEFAULT_PRICE_PER_KWH=997.92

# === CORS ===
# Orígenes permitidos (separados por coma). En producción añade aquí el dominio
# real del frontend (por ejemplo el de Vercel) cuando lo tengas.
CORS_ORIGINS=http://localhost:3000
